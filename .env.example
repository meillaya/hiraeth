# Hiraeth production environment template.
# Copy values into the deployment secret store; do not commit real secrets.

# Generate with: mix phx.gen.secret
# required
SECRET_KEY_BASE=replace-with-generated-secret-key-base

# PostgreSQL connection string for the production database.
# required
DATABASE_URL=postgres://hiraeth_user:replace-with-database-password@postgres:5432/hiraeth_prod

# Public host name used for Phoenix URL generation.
# required
PHX_HOST=hiraeth.example.com

# Scrapling sidecar HTTP endpoint reachable from the Phoenix service.
# On Railway this is the private-network address of the sidecar service.
# required
SCRAPLING_SIDECAR_URL=http://sidecar.railway.internal:8000

# Shared secret for HMAC-signed sidecar requests. The production sidecar image
# runs in secure mode and rejects unsigned data requests.
# required
SCRAPLING_SIDECAR_TOKEN=replace-with-a-shared-sidecar-secret

# Cover object storage. Leave local for a disk-only cache; set s3 to back the
# local cache with Cloudflare R2. The R2_* variables are required in s3 mode.
# optional
HIRAETH_COVER_STORE=local
# required when HIRAETH_COVER_STORE=s3
R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
# required when HIRAETH_COVER_STORE=s3
R2_BUCKET=hiraeth-covers
# required when HIRAETH_COVER_STORE=s3
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
# required when HIRAETH_COVER_STORE=s3
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
# optional
R2_REGION=auto
# optional
HIRAETH_COVER_CACHE_MAX_BYTES=1073741824
# Fill uncached cover assets once at boot (production only; default true).
# Independent of HIRAETH_SCHEDULED_INGEST because it never ingests catalog data.
# optional
HIRAETH_COVER_BACKFILL_ON_BOOT=true

# LiveView signing salt; generate with: mix phx.gen.secret
# required
LIVE_VIEW_SIGNING_SALT=replace-with-generated-live-view-signing-salt

# Ecto database connection pool size for one application instance.
# optional
POOL_SIZE=10

# Common release/runtime settings.
# optional
PHX_SERVER=true
# optional
PORT=4000

# Logger level for production (debug|info|warning|error); defaults to info.
# optional
LOG_LEVEL=info

# Optional: libcluster DNS query for multi-node clustering.
# optional
DNS_CLUSTER_QUERY=

# Optional: set to true/1 to enable IPv6 socket options for the repo.
# optional
ECTO_IPV6=false

# Autonomous ingestion kill-switch: set to false to disable ALL scheduled
# Oban cron entries (15-min scheduler tick, weekly cover refresh, weekly
# provenance audit). Manual mix tasks (e.g. mix hiraeth.ingest) are unaffected.
# optional; defaults to true
HIRAETH_SCHEDULED_INGEST=true

# Deployment role for the shared release image: web | worker | all
HIRAETH_SERVICE_ROLE=all
# Rebuild the public read model on worker boot
HIRAETH_PROJECTION_ON_BOOT=true

# Read-only ops health page. Leave either unset to return 404.
# optional
HIRAETH_OPS_USERNAME=
HIRAETH_OPS_PASSWORD=

# Candidate-review write console at /admin. Leave either unset to return 404.
# optional
HIRAETH_ADMIN_USERNAME=
HIRAETH_ADMIN_PASSWORD=
