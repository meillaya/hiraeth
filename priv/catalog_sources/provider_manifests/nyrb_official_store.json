{
  "provider": "nyrb_official_store",
  "name": "NYRB",
  "source_mode": "api",
  "source_urls": [
    "https://www.nyrb.com/collections/classics/products.json",
    "https://www.nyrb.com/collections/new-york-review-books/products.json",
    "https://www.nyrb.com/collections/nyrb-poets/products.json"
  ],
  "source_hosts": [
    "www.nyrb.com"
  ],
  "cover_hosts": [
    "cdn.shopify.com",
    "covers.openlibrary.org"
  ],
  "api": {
    "type": "shopify",
    "endpoint": "https://www.nyrb.com",
    "auth": null,
    "collection_paths": [
      "collections/classics",
      "collections/new-york-review-books",
      "collections/nyrb-poets"
    ],
    "allowed_vendors": []
  },
  "rate_limit": {
    "max_concurrency": 1,
    "min_delay_ms": 500,
    "max_bytes": 52428800
